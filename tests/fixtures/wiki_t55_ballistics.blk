 ballistics {
   bullet {
     bulletType:t = "apds_fs_tungsten_small_core_tank"
     speed:r = 1430.0

     drawAdditionalLines:b = no
     drawDistanceCorrection:b = yes
     distanceCorrectionPos:p2 = -0.15, -0.15
